/*
 * eDNA Metabarcoding Pipeline — Nextflow Configuration
 */

manifest {
    name            = 'edna-metabarcoding'
    author          = 'DECODE'
    description     = 'Multi-marker eDNA pipeline: 16S, 18S, ITS, CO1, 12S'
    version         = '1.0.0'
    nextflowVersion = '>=23.04.0'
    defaultBranch   = 'main'
}

// ─── Default parameters ──────────────────────────────────────────────────────

params {
    // Required
    input            = null           // Samplesheet CSV
    outdir           = 'results'
    markers          = '16S'          // Comma-separated list or single marker

    // Optional
    metadata         = null           // Sample metadata TSV for ecology
    single_end       = false

    // DADA2 settings (can be overridden per marker in primers block)
    dada2_pool       = false          // true | false | 'pseudo'
    dada2_chimera    = 'consensus'    // 'consensus' | 'pooled' | 'per-sample'

    // Cutadapt settings
    cutadapt_args    = '--discard-untrimmed --minimum-length 50'
    cutadapt_cores   = 4

    // VSEARCH chimera settings
    vsearch_id       = 1.0

    // MultiQC
    multiqc_config   = null
    multiqc_title    = null

    // ── Ecology switches ───────────────────────────────────────────────────
    run_ecology          = true    // Basic ecology (barplots, PCoA, basic diversity)
    run_full_ecology     = true    // Full ecological analysis suite (all 9 modules)

    // Full ecology options
    ecology_group_var       = null    // Primary grouping variable in metadata (e.g. 'habitat')
    ecology_min_prevalence  = 0.3     // Network: min fraction of samples for taxon to be included
    ecology_cor_cutoff      = 0.6     // Network: minimum |Spearman r| for an edge

    // Max resource limits
    max_memory       = '128.GB'
    max_cpus         = 32
    max_time         = '240.h'

    // ── Primer configurations ──────────────────────────────────────────────
    primers {
        '16S' {
            fwd         = 'GTGYCAGCMGCCGCGGTAA'      // 515F (Parada)
            rev         = 'GGACTACNVGGGTWTCTAAT'      // 806RB (Apprill)
            min_length  = 200
            max_length  = 320
            trunc_len_f = 230
            trunc_len_r = 160
            max_ee_f    = 2
            max_ee_r    = 2
        }
        '18S' {
            fwd         = 'CCAGCASCYGCGGTAATTCC'      // TAReuk454FWD1
            rev         = 'ACTTTCGTTCTTGATYRA'        // TAReukREV3
            min_length  = 150
            max_length  = 500
            trunc_len_f = 0
            trunc_len_r = 0
            max_ee_f    = 2
            max_ee_r    = 2
        }
        'ITS' {
            fwd         = 'CTTGGTCATTTAGAGGAAGTAA'    // ITS1F
            rev         = 'GCTGCGTTCTTCATCGATGC'      // ITS2
            min_length  = 100
            max_length  = 600
            trunc_len_f = 0  // Variable length — no truncation
            trunc_len_r = 0
            max_ee_f    = 2
            max_ee_r    = 2
        }
        'CO1' {
            fwd         = 'GGWACWGGWTGAACWGTWTAYCCYCC'  // mlCOIintF (Leray)
            rev         = 'TAIACYTCIGGRTGICCRAARAAYCA'  // jgHCO2198
            min_length  = 300
            max_length  = 420
            trunc_len_f = 0
            trunc_len_r = 0
            max_ee_f    = 2
            max_ee_r    = 2
        }
        '12S' {
            fwd         = 'GTCGGTAAAACTCGTGCCAGC'      // MiFish-U-F
            rev         = 'CATAGTGGGGTATCTAATCCCAGTTTG' // MiFish-U-R
            min_length  = 163
            max_length  = 185
            trunc_len_f = 0
            trunc_len_r = 0
            max_ee_f    = 2
            max_ee_r    = 2
        }
    }

    // ── Taxonomy database configurations ───────────────────────────────────
    // Set these paths to your local database files
    databases {
        '16S' {
            path   = "${projectDir}/databases/silva_nr99_v138.1_train_set.fa.gz"
            type   = 'silva'
            method = 'dada2'
        }
        '18S' {
            path   = "${projectDir}/databases/pr2_version_5.0.0_SSU_dada2.fasta.gz"
            type   = 'pr2'
            method = 'dada2'
        }
        'ITS' {
            path   = "${projectDir}/databases/sh_general_release_dynamic_s_all_19.02.2024.fasta.gz"
            type   = 'unite'
            method = 'dada2'
        }
        'CO1' {
            path   = "${projectDir}/databases/MIDORI2_LONGEST_NUC_GB262_CO1_DADA2.fasta.gz"
            type   = 'midori'
            method = 'dada2'
        }
        '12S' {
            path   = "${projectDir}/databases/MIDORI2_LONGEST_NUC_GB262_12S_DADA2.fasta.gz"
            type   = 'midori'
            method = 'dada2'
        }
    }
}

// ─── Process defaults ────────────────────────────────────────────────────────

process {
    errorStrategy = { task.exitStatus in [143, 137, 104, 134, 139] ? 'retry' : 'finish' }
    maxRetries    = 2
    maxErrors     = '-1'
}

// ─── Profiles ────────────────────────────────────────────────────────────────

profiles {

    // Local execution — no containers
    standard {
        process.executor = 'local'
    }

    // Docker containers
    docker {
        docker.enabled         = true
        docker.userEmulation   = true
        singularity.enabled    = false
        process {
            withLabel: 'process_single'  { cpus = 1;  memory = '6.GB';  time = '4.h'  }
            withLabel: 'process_low'     { cpus = 2;  memory = '12.GB'; time = '4.h'  }
            withLabel: 'process_medium'  { cpus = 6;  memory = '36.GB'; time = '8.h'  }
            withLabel: 'process_high'    { cpus = 12; memory = '72.GB'; time = '16.h' }
        }
    }

    // Singularity containers (HPC)
    singularity {
        singularity.enabled    = true
        singularity.autoMounts = true
        docker.enabled         = false
        process {
            withLabel: 'process_single'  { cpus = 1;  memory = '6.GB';  time = '4.h'  }
            withLabel: 'process_low'     { cpus = 2;  memory = '12.GB'; time = '4.h'  }
            withLabel: 'process_medium'  { cpus = 6;  memory = '36.GB'; time = '8.h'  }
            withLabel: 'process_high'    { cpus = 12; memory = '72.GB'; time = '16.h' }
        }
    }

    // SLURM HPC cluster
    slurm {
        process.executor       = 'slurm'
        process.queue          = 'compute'
        singularity.enabled    = true
        singularity.autoMounts = true
        process {
            withLabel: 'process_single'  { cpus = 1;  memory = '6.GB';  time = '4.h';  queue = 'short'   }
            withLabel: 'process_low'     { cpus = 2;  memory = '12.GB'; time = '4.h';  queue = 'short'   }
            withLabel: 'process_medium'  { cpus = 6;  memory = '36.GB'; time = '8.h';  queue = 'compute' }
            withLabel: 'process_high'    { cpus = 12; memory = '72.GB'; time = '16.h'; queue = 'compute' }
        }
    }

    // PBS/Torque HPC cluster
    pbs {
        process.executor       = 'pbspro'
        singularity.enabled    = true
        singularity.autoMounts = true
    }

    // Test profile with minimal resources
    test {
        params.input    = "${projectDir}/assets/test_samplesheet.csv"
        params.outdir   = 'test_results'
        params.markers  = '16S,ITS'
        params.databases {
            '16S' { path = "${projectDir}/assets/test_db_16S.fa.gz" }
            'ITS' { path = "${projectDir}/assets/test_db_ITS.fa.gz" }
        }
        process {
            withLabel: 'process_high' { cpus = 2; memory = '8.GB' }
        }
    }
}

// ─── Reporting ───────────────────────────────────────────────────────────────

def trace_timestamp = new java.util.Date().format('yyyy-MM-dd_HH-mm-ss')

report {
    enabled   = true
    overwrite = true
    file      = "${params.outdir}/pipeline_info/execution_report_${trace_timestamp}.html"
}

timeline {
    enabled   = true
    overwrite = true
    file      = "${params.outdir}/pipeline_info/execution_timeline_${trace_timestamp}.html"
}

trace {
    enabled   = true
    overwrite = true
    file      = "${params.outdir}/pipeline_info/execution_trace_${trace_timestamp}.txt"
}

dag {
    enabled   = true
    overwrite = true
    file      = "${params.outdir}/pipeline_info/pipeline_dag_${trace_timestamp}.svg"
}

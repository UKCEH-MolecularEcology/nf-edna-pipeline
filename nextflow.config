/*
 * eDNA Metabarcoding Pipeline — Nextflow Configuration
 */

manifest {
    name            = 'edna-metabarcoding'
    author          = 'DECODE'
    description     = 'Multi-marker eDNA pipeline: 16S, 18S, ITS, CO1, 12S, rbcL'
    version         = '1.0.0'
    nextflowVersion = '>=23.04.0'
    defaultBranch   = 'main'
}

// ─── Default parameters ──────────────────────────────────────────────────────

params {
    // Required (provide one of input or fastq_dir)
    input            = null           // Samplesheet CSV (mutually exclusive with fastq_dir)
    fastq_dir        = null           // FASTQ directory — auto-detects samples and markers
    outdir           = 'results'
    markers          = '16S'          // Comma-separated list; ignored when using fastq_dir

    // Optional
    metadata         = null           // Sample metadata TSV for ecology
    single_end       = false

    // ── CPU / thread control ───────────────────────────────────────────────
    // Use --cores N to set the number of threads available to the pipeline.
    // All process labels scale from this value (see process block below).
    cores            = 4

    // ── DADA2 settings ─────────────────────────────────────────────────────
    dada2_pool       = false          // true | false | 'pseudo'
    dada2_chimera    = 'consensus'    // 'consensus' | 'pooled' | 'per-sample'

    // ── RDP Classifier settings (rbcL) ─────────────────────────────────────
    rdp_mem          = '200g'           // JVM heap for rdp_classifier -Xmx
    rdp_bootstrap    = 0.70           // Min bootstrap confidence to retain an assignment (0–1)

    // ── Cutadapt settings ──────────────────────────────────────────────────
    cutadapt_args    = '--discard-untrimmed --minimum-length 50'

    // Set true when input reads already had primers stripped upstream (e.g.
    // a "15_no_primers" delivery from the sequencing facility) -- CUTADAPT
    // then copies reads through unchanged instead of searching for a primer
    // sequence that's no longer there (which would otherwise discard nearly
    // everything via --discard-untrimmed).
    primers_already_removed = false

    // ── VSEARCH chimera settings ────────────────────────────────────────────
    vsearch_id       = 1.0

    // ── MultiQC ────────────────────────────────────────────────────────────
    multiqc_config   = null
    multiqc_title    = null

    // ── Database setup ─────────────────────────────────────────────────
    skip_db_download = false    // Set true to disable auto-download of missing databases

    // ── Shared R package library for ecology modules ──────────────────────
    // All ecology tasks share one library so packages are only installed once.
    // Override with --r_lib_cache /your/path if needed.
    r_lib_cache          = "${projectDir}/r_libs"

    // ── Ecology switches ───────────────────────────────────────────────────
    run_ecology          = true    // Basic ecology (barplots, PCoA, basic diversity)
    run_full_ecology     = true    // Full ecological analysis suite (all 9 modules)
    skip_ecology_markers = null    // Comma-separated markers to skip ecology for
                                   // e.g. --skip_ecology_markers 'RBCL,CO1'

    // Full ecology options
    ecology_group_var       = null    // Primary grouping variable in metadata (e.g. 'habitat')
    ecology_min_prevalence  = 0.3     // Network: min fraction of samples for taxon to be included
    ecology_cor_cutoff      = 0.6     // Network: minimum |Spearman r| for an edge

    // ── Hard resource caps ─────────────────────────────────────────────────
    max_memory       = '2056.GB'
    max_time         = '240.h'

    // ── Primer configurations ──────────────────────────────────────────────
    primers {
        '16S' {
            fwd         = 'GTGYCAGCMGCCGCGGTAA'      // 515F (Parada)
            rev         = 'GGACTACNVGGGTWTCTAAT'      // 806RB (Apprill)
            min_length  = 200
            max_length  = 320
            trunc_len_f = 230
            trunc_len_r = 160
            max_ee_f    = 2
            max_ee_r    = 2
        }
        '18S' {
            fwd         = 'CCAGCASCYGCGGTAATTCC'      // TAReuk454FWD1
            rev         = 'ACTTTCGTTCTTGATYRA'        // TAReukREV3
            min_length  = 150
            max_length  = 500
            trunc_len_f = 0
            trunc_len_r = 0
            max_ee_f    = 2
            max_ee_r    = 2
        }
        'ITS' {
            fwd         = 'CTTGGTCATTTAGAGGAAGTAA'    // ITS1F
            rev         = 'GCTGCGTTCTTCATCGATGC'      // ITS2
            min_length  = 100
            max_length  = 600
            trunc_len_f = 0  // Variable length — no truncation
            trunc_len_r = 0
            max_ee_f    = 2
            max_ee_r    = 2
        }
        'CO1' {
            fwd         = 'GGWACWGGWTGAACWGTWTAYCCYCC'  // mlCOIintF (Leray)
            rev         = 'TAIACYTCIGGRTGICCRAARAAYCA'  // jgHCO2198
            min_length  = 300
            max_length  = 420
            trunc_len_f = 0
            trunc_len_r = 0
            max_ee_f    = 2
            max_ee_r    = 2
        }
        '12S' {
            fwd         = 'ACTGGGATTAGATACCCC'         // Riaz V5 fwd
            rev         = 'TAGAACAGGCTCCTCTAG'          // Riaz V5 rev
            fusion_tag  = false                          // set true if a fusion tag was used in library prep
                                                           // (swaps fwd primer's first base A->R to match reads)
            min_length  = 100
            max_length  = 130
            trunc_len_f = 0
            trunc_len_r = 0
            max_ee_f    = 2
            max_ee_r    = 2
        }
        'RBCL' {
            fwd         = 'ATGTCACCACAAACAGAGACTAAAGC'  // rbcLa-F (Kress & Erickson 2007)
            rev         = 'GTAAAATCAAGTCCACCRCG'         // rbcLa-R (Kress & Erickson 2007)
            min_length  = 400
            max_length  = 600
            trunc_len_f = 0  // Variable length — no truncation
            trunc_len_r = 0
            max_ee_f    = 2
            max_ee_r    = 2
        }
    }

    // ── Taxonomy database configurations ───────────────────────────────────
    // Set these paths to your local database files
    databases {
        '16S' {
            path   = "${projectDir}/databases/silva_nr99_v138.1_train_set.fa.gz"
            type   = 'silva'
            method = 'dada2'
        }
        '18S' {
            path   = "${projectDir}/databases/pr2_version_5.0.0_SSU_dada2.fasta.gz"
            type   = 'pr2'
            method = 'dada2'
        }
        'ITS' {
            path   = "${projectDir}/databases/sh_general_release_dynamic_all_19.02.2025.fasta"
            type   = 'unite'
            method = 'dada2'
        }
        'CO1' {
            // coidb (SciLifeLab/Insect Biome Atlas), not MIDORI2: MIDORI2 has
            // no bacterial reference at all, so it can't recognize the ~77%
            // of CO1 ASVs that look like off-target bacterial amplicons
            // (mostly Pseudomonadota) — it just confidently mis-assigns them
            // to some eukaryotic phylum instead. coidb includes both, so it
            // can actually tell target reads from contamination.
            path            = "/hdd0/susbus/databases/CO1/coidb_scilifelab/dada2/coidb.dada2.toGenus.exclNA.fasta.gz"
            addspecies_path = "/hdd0/susbus/databases/CO1/coidb_scilifelab/dada2/coidb.dada2.addSpecies.exclNA.fasta.gz"
            type            = 'coidb'
            method          = 'dada2'
        }
        '12S' {
            // 12S taxonomy is handled by the dedicated SINTAX_12S subworkflow
            // (params.sintax below), not the generic per-sample TAXONOMY module —
            // 'skip' short-circuits it. Points at a real, harmless file so the
            // generic missing-database auto-download check doesn't trip on it.
            path   = "${projectDir}/assets/NO_FILE"
            type   = 'none'
            method = 'skip'
        }
        'RBCL' {
            // Trained on NCBI plant rbcL sequences (terrimporter/rbcLClassifier v1)
            path   = "${projectDir}/databases/mydata_trained"
            type   = 'rdp'
            method = 'rdp'
        }
    }

    // ── 12S "Tapirs" branch (fastp/vsearch/BLAST/Kraken2/MLCA) ─────────────
    // A second, independent 12S taxonomic-assignment pipeline, ported from
    // the 12S-edna-dada2-tapirs-workflow Snakemake pipeline. Runs alongside
    // (not instead of) the generic DADA2 path; outputs are self-contained
    // OTU tables, not fed into ecology.
    tapirs {
        enabled                = false
        experiment             = null    // output filename prefix (was `my_experiment`)
        cluster_method         = 'denoise'   // 'denoise' | 'cluster'
        chimera_detection      = 'denovo'    // 'denovo'  | 'ref'
        analysis_method        = 'both'      // 'blast' | 'kraken2' | 'both'
        lowest_taxonomic_rank  = 'species'
        highest_taxonomic_rank = 'order'

        fastp {
            max_len1                  = 106
            max_len2                  = 106
            trim_front1                = 0
            trim_front2                = 0
            qual_phred                 = 30
            unqualified_percent_limit  = 40
            window_size                = 5
            len_required                = 60
            poly_g_min                  = 10
            poly_x_min                  = 10
            min_overlap                 = 20
            diff_percent_limit          = 5
            diff_limit                  = 5
            length_limit                = 110
        }
        vsearch {
            minuniqsize  = 3
            minsize      = 1
            unoise_alpha = 2.0
            unoise_id    = 0.99
            cluster_id   = 1
            query_cov    = 1
            mindiffs     = 1
            mindiv       = 0.8
            abskew       = 16.0
        }
        blast {
            db              = null
            max_target_seqs = 50
            min_perc_ident  = 75
            min_evalue      = 1e-20
        }
        mlca {
            bitscore = 2
            identity = 98
            coverage = 90     // was the Snakemake config's typo'd `MCLA_coverage`
            majority = 80
            min_hits = 1
        }
        kraken2 {
            db         = null
            confidence = 0.0
            mem        = '100.GB'
        }
        taxdump         = null
        dechim_blast_db = null   // only used when chimera_detection == 'ref'
    }

    // CO1's own BLAST + majority-vote-LCA branch (via coidb), run against
    // the collective post-merge CO1 ASV set -- a second, independent
    // instantiation of the same TAPIRS_BLAST/TAPIRS_BLAST_LCA modules as
    // the `tapirs` block above, not a change to it. Standalone output,
    // does not feed ecology (same as 12S's Tapirs branch).
    tapirs_blast_lca_co1 {
        // nt (NCBI Nucleotide collection, /prj/DECODE/databases/nt), not coidb
        // or MetaCOXI: testing real CO1 ASVs against all three found nt gives
        // a strong, significant hit (>=80% query coverage, e-value <=1e-10)
        // for ~32% of ASVs, versus ~0% for coidb/MetaCOXI -- neither
        // curated COI-specific reference has close enough relatives for this
        // sample. Thresholds below (task=blastn not the default megablast,
        // identity>=60, coverage>=70) are set from that real hit-quality
        // distribution, not guessed -- coidb's old 98%/90% mlca thresholds
        // rejected every real cross-species match in this dataset.
        enabled = false
        blast {
            db_dir          = "/prj/DECODE/databases/nt"
            db_prefix       = 'nt'
            task            = 'blastn'  // not the default megablast -- see TAPIRS_BLAST module
            max_target_seqs = 50
            min_perc_ident  = 60
            min_evalue      = 1e-20
        }
        mlca {
            bitscore = 2
            identity = 60
            coverage = 70
            majority = 80
            min_hits = 1
        }
        taxdump = "/hdd0/susbus/databases/ncbi"
    }

    // ── 12S SINTAX taxonomy + blank cleanup ────────────────────────────────
    // Runs on the marker-level merged, chimera-free ASV set produced by
    // MERGE_ASV_TABLES for 12S (see params.databases['12S'].method = 'skip'
    // above), against 3 reference databases, then applies LOD-based blank
    // cleanup keyed off sample-name regexes.
    sintax {
        enabled   = false
        cutoff    = 0.7
        databases = ['INBO', 'MIDORI', 'CLARE']
        db_paths  = [
            INBO:   "${projectDir}/databases/sintax_inbo.fasta",
            MIDORI: "${projectDir}/databases/sintax_midori.fasta.gz",
            CLARE:  "${projectDir}/databases/sintax_clare.fasta"
        ]

        blank_cleanup {
            enable_taxon_exclusion = false   // OFF by default — matches current
                                              // Snakemake runtime behavior (the
                                              // human/livestock filter exists in
                                              // that pipeline's code but is
                                              // commented out there too)
            excluded_taxa          = ['Homo_sapiens', 'Sus_scrofa', 'Canis_lupus',
                                       'Ovis_aries', 'Bos_taurus', 'Bovidae']
            lod_mode               = 'both'   // 'lab' | 'site' | 'both'
            lod_sd_multiplier      = 3
            loq_sd_multiplier      = 10
            pcr_blank_regex        = 'PCR_BLANK|PCRBLANK|NEG|POS'
            extraction_blank_regex = 'EXTRACTION_BLANK|EXTRACTIONBLANK|_EB_|_EB[0-9]'
            site_blank_regex       = 'BLANK'
        }
    }
}

// ─── Process defaults and CPU scaling ────────────────────────────────────────
//
// CPU allocations for each label scale from --cores (params.cores):
//
//   --cores    process_single  process_low  process_medium  process_high
//        4          1              2              4               4
//        8          1              2              4               8
//       16          1              2              4              16
//       32          1              4              8              32
//       64          1              8             16              64
//
// Memory and walltime limits are set per profile below.

process {
    errorStrategy = { task.exitStatus in [143, 137, 104, 134, 139] ? 'retry' : 'finish' }
    maxRetries    = 2
    maxErrors     = '-1'

    withLabel: 'process_single' { cpus = 1 }
    withLabel: 'process_low'    { cpus = Math.max(2, (int)(params.cores / 8))  }
    withLabel: 'process_medium' { cpus = Math.max(4, (int)(params.cores / 4))  }
    withLabel: 'process_high'   { cpus = params.cores                           }

    // DADA2_DENOISE processes one sample per job; dada() only parallelises
    // across multiple samples in a single call, so extra threads are wasted.
    // Use 1 CPU to allow all 72 cores to run samples simultaneously.
    withName: 'DADA2_DENOISE' { cpus = 1 }

    // Kraken2 needs its whole database resident in RAM regardless of the
    // process_high memory ceiling set per-profile below; size explicitly via
    // --tapirs.kraken2.mem to match your actual database.
    withName: 'TAPIRS_KRAKEN2' { memory = { params.tapirs.kraken2.mem } }

    // Collective assignTaxonomy() classifies every marker's whole merged ASV
    // set (tens of thousands of ASVs for ITS/CO1) in one task — pin cpus
    // explicitly by name (rather than relying on the process_high label,
    // which was observed resolving to 1 cpu for this process) and give it
    // its own, longer walltime independent of the shared process_high ceiling.
    withName: 'TAXONOMY' {
        cpus = params.cores
        time = { 48.h * task.attempt }
    }

    // Rarefaction curves / richness estimation (iNEXT) scale poorly with ASV
    // count — ITS's ~16k-ASV collective set exceeded process_low's 4h ceiling
    // and ran on a single core (mc.cores=1), despite process_low's cpus
    // formula intending Math.max(2, cores/8). Pin cpus explicitly by name,
    // same fix as TAXONOMY above, and give it more walltime too.
    withName: 'ECOLOGY_ALPHA' {
        cpus = Math.max(2, (int)(params.cores / 8))
        time = { 24.h * task.attempt }
    }

    // Same process_high-label-resolves-to-1-cpu issue as TAXONOMY/ECOLOGY_ALPHA
    // above. Matters most for CO1's Tapirs branch, which BLASTs the entire
    // collective ~18k-ASV set against coidb (4.7M seqs) in one task, not
    // per-sample like 12S's (much smaller) calls to the same process.
    withName: 'TAPIRS_BLAST' {
        cpus = params.cores
    }
}

// ─── Profiles ────────────────────────────────────────────────────────────────

profiles {

    // Local execution — no containers
    standard {
        process.executor = 'local'
    }

    // Docker containers
    docker {
        docker.enabled         = true
        docker.userEmulation   = true
        singularity.enabled    = false
        process {
            withLabel: 'process_single' { memory = '6.GB';  time = '4.h'  }
            withLabel: 'process_low'    { memory = '12.GB'; time = '4.h'  }
            withLabel: 'process_medium' { memory = '36.GB'; time = '8.h'  }
            withLabel: 'process_high'   { memory = '72.GB'; time = '16.h' }
        }
    }

    // Singularity containers (HPC)
    singularity {
        singularity.enabled    = true
        singularity.autoMounts = true
        singularity.cacheDir   = "${launchDir}/work/singularity"
        docker.enabled         = false
        env.SINGULARITY_CACHEDIR = "${launchDir}/work/singularity"
        process {
            withLabel: 'process_single' { memory = '6.GB';  time = '4.h'  }
            withLabel: 'process_low'    { memory = '12.GB'; time = '4.h'  }
            withLabel: 'process_medium' { memory = '36.GB'; time = '8.h'  }
            withLabel: 'process_high'   { memory = '72.GB'; time = '16.h' }
        }
    }

    // SLURM HPC cluster
    slurm {
        process.executor       = 'slurm'
        process.queue          = 'compute'
        singularity.enabled    = true
        singularity.autoMounts = true
        process {
            withLabel: 'process_single' { memory = '6.GB';  time = '4.h';  queue = 'short'   }
            withLabel: 'process_low'    { memory = '12.GB'; time = '4.h';  queue = 'short'   }
            withLabel: 'process_medium' { memory = '36.GB'; time = '8.h';  queue = 'compute' }
            withLabel: 'process_high'   { memory = '72.GB'; time = '16.h'; queue = 'compute' }
        }
    }

    // PBS/Torque HPC cluster
    pbs {
        process.executor       = 'pbspro'
        singularity.enabled    = true
        singularity.autoMounts = true
    }

    // Test profile — tiny synthetic data for CI (preview and unit tests)
    test {
        params {
            fastq_dir        = "${projectDir}/tests/data/fastq"
            outdir           = 'test_results'
            cores            = 2
            skip_db_download = true
            run_ecology      = false
            run_full_ecology = false
            databases {
                '16S' {
                    path   = "${projectDir}/tests/data/databases/silva_16S_test.fa.gz"
                    type   = 'silva'
                    method = 'dada2'
                }
            }
        }
        process {
            withLabel: 'process_high'   { memory = '4.GB' }
            withLabel: 'process_medium' { memory = '4.GB' }
        }
    }
}

// ─── Reporting ───────────────────────────────────────────────────────────────

def trace_timestamp = new java.util.Date().format('yyyy-MM-dd_HH-mm-ss')

report {
    enabled   = true
    overwrite = true
    file      = "${params.outdir}/pipeline_info/execution_report_${trace_timestamp}.html"
}

timeline {
    enabled   = true
    overwrite = true
    file      = "${params.outdir}/pipeline_info/execution_timeline_${trace_timestamp}.html"
}

trace {
    enabled   = true
    overwrite = true
    file      = "${params.outdir}/pipeline_info/execution_trace_${trace_timestamp}.txt"
}

dag {
    enabled   = true
    overwrite = true
    file      = "${params.outdir}/pipeline_info/pipeline_dag_${trace_timestamp}.svg"
}

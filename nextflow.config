/*
 * eDNA Metabarcoding Pipeline — Nextflow Configuration
 */

manifest {
    name            = 'edna-metabarcoding'
    author          = 'DECODE'
    description     = 'Multi-marker eDNA pipeline: 16S, 18S, ITS, CO1, 12S, rbcL'
    version         = '1.0.0'
    nextflowVersion = '>=23.04.0'
    defaultBranch   = 'main'
}

// ─── Default parameters ──────────────────────────────────────────────────────

params {
    // Required (provide one of input or fastq_dir)
    input            = null           // Samplesheet CSV (mutually exclusive with fastq_dir)
    fastq_dir        = null           // FASTQ directory — auto-detects samples and markers
    outdir           = 'results'
    markers          = '16S'          // Comma-separated list; ignored when using fastq_dir

    // Optional
    metadata         = null           // Sample metadata TSV for ecology
    single_end       = false

    // ── CPU / thread control ───────────────────────────────────────────────
    // Use --cores N to set the number of threads available to the pipeline.
    // All process labels scale from this value (see process block below).
    cores            = 4

    // ── DADA2 settings ─────────────────────────────────────────────────────
    dada2_pool       = false          // true | false | 'pseudo'
    dada2_chimera    = 'consensus'    // 'consensus' | 'pooled' | 'per-sample'

    // ── RDP Classifier settings (rbcL) ─────────────────────────────────────
    rdp_mem          = '200g'           // JVM heap for rdp_classifier -Xmx
    rdp_bootstrap    = 0.70           // Min bootstrap confidence to retain an assignment (0–1)

    // ── Cutadapt settings ──────────────────────────────────────────────────
    cutadapt_args    = '--discard-untrimmed --minimum-length 50'

    // ── VSEARCH chimera settings ────────────────────────────────────────────
    vsearch_id       = 1.0

    // ── MultiQC ────────────────────────────────────────────────────────────
    multiqc_config   = null
    multiqc_title    = null

    // ── Database setup ─────────────────────────────────────────────────
    skip_db_download = false    // Set true to disable auto-download of missing databases

    // ── Ecology switches ───────────────────────────────────────────────────
    run_ecology          = true    // Basic ecology (barplots, PCoA, basic diversity)
    run_full_ecology     = true    // Full ecological analysis suite (all 9 modules)
    skip_ecology_markers = null    // Comma-separated markers to skip ecology for
                                   // e.g. --skip_ecology_markers 'RBCL,CO1'

    // Full ecology options
    ecology_group_var       = null    // Primary grouping variable in metadata (e.g. 'habitat')
    ecology_min_prevalence  = 0.3     // Network: min fraction of samples for taxon to be included
    ecology_cor_cutoff      = 0.6     // Network: minimum |Spearman r| for an edge

    // ── Hard resource caps ─────────────────────────────────────────────────
    max_memory       = '2056.GB'
    max_time         = '240.h'

    // ── Primer configurations ──────────────────────────────────────────────
    primers {
        '16S' {
            fwd         = 'GTGYCAGCMGCCGCGGTAA'      // 515F (Parada)
            rev         = 'GGACTACNVGGGTWTCTAAT'      // 806RB (Apprill)
            min_length  = 200
            max_length  = 320
            trunc_len_f = 230
            trunc_len_r = 160
            max_ee_f    = 2
            max_ee_r    = 2
        }
        '18S' {
            fwd         = 'CCAGCASCYGCGGTAATTCC'      // TAReuk454FWD1
            rev         = 'ACTTTCGTTCTTGATYRA'        // TAReukREV3
            min_length  = 150
            max_length  = 500
            trunc_len_f = 0
            trunc_len_r = 0
            max_ee_f    = 2
            max_ee_r    = 2
        }
        'ITS' {
            fwd         = 'CTTGGTCATTTAGAGGAAGTAA'    // ITS1F
            rev         = 'GCTGCGTTCTTCATCGATGC'      // ITS2
            min_length  = 100
            max_length  = 600
            trunc_len_f = 0  // Variable length — no truncation
            trunc_len_r = 0
            max_ee_f    = 2
            max_ee_r    = 2
        }
        'CO1' {
            fwd         = 'GGWACWGGWTGAACWGTWTAYCCYCC'  // mlCOIintF (Leray)
            rev         = 'TAIACYTCIGGRTGICCRAARAAYCA'  // jgHCO2198
            min_length  = 300
            max_length  = 420
            trunc_len_f = 0
            trunc_len_r = 0
            max_ee_f    = 2
            max_ee_r    = 2
        }
        '12S' {
            fwd         = 'GTCGGTAAAACTCGTGCCAGC'      // MiFish-U-F
            rev         = 'CATAGTGGGGTATCTAATCCCAGTTTG' // MiFish-U-R
            min_length  = 163
            max_length  = 185
            trunc_len_f = 0
            trunc_len_r = 0
            max_ee_f    = 2
            max_ee_r    = 2
        }
        'RBCL' {
            fwd         = 'ATGTCACCACAAACAGAGACTAAAGC'  // rbcLa-F (Kress & Erickson 2007)
            rev         = 'GTAAAATCAAGTCCACCRCG'         // rbcLa-R (Kress & Erickson 2007)
            min_length  = 400
            max_length  = 600
            trunc_len_f = 0  // Variable length — no truncation
            trunc_len_r = 0
            max_ee_f    = 2
            max_ee_r    = 2
        }
    }

    // ── Taxonomy database configurations ───────────────────────────────────
    // Set these paths to your local database files
    databases {
        '16S' {
            path   = "${projectDir}/databases/silva_nr99_v138.1_train_set.fa.gz"
            type   = 'silva'
            method = 'dada2'
        }
        '18S' {
            path   = "${projectDir}/databases/pr2_version_5.0.0_SSU_dada2.fasta.gz"
            type   = 'pr2'
            method = 'dada2'
        }
        'ITS' {
            path   = "${projectDir}/databases/sh_general_release_dynamic_all_19.02.2025.fasta"
            type   = 'unite'
            method = 'dada2'
        }
        'CO1' {
            path   = "${projectDir}/databases/MIDORI2_LONGEST_NUC_GB270_CO1_DADA2.fasta.gz"
            type   = 'midori'
            method = 'dada2'
        }
        '12S' {
            path   = "${projectDir}/databases/MIDORI2_LONGEST_NUC_GB270_srRNA_DADA2.fasta.gz"
            type   = 'midori'
            method = 'dada2'
        }
        'RBCL' {
            // Trained on NCBI plant rbcL sequences (terrimporter/rbcLClassifier v1)
            path   = "${projectDir}/databases/mydata_trained"
            type   = 'rdp'
            method = 'rdp'
        }
    }
}

// ─── Process defaults and CPU scaling ────────────────────────────────────────
//
// CPU allocations for each label scale from --cores (params.cores):
//
//   --cores    process_single  process_low  process_medium  process_high
//        4          1              2              4               4
//        8          1              2              4               8
//       16          1              2              4              16
//       32          1              4              8              32
//       64          1              8             16              64
//
// Memory and walltime limits are set per profile below.

process {
    errorStrategy = { task.exitStatus in [143, 137, 104, 134, 139] ? 'retry' : 'finish' }
    maxRetries    = 2
    maxErrors     = '-1'

    withLabel: 'process_single' { cpus = 1 }
    withLabel: 'process_low'    { cpus = Math.max(2, (int)(params.cores / 8))  }
    withLabel: 'process_medium' { cpus = Math.max(4, (int)(params.cores / 4))  }
    withLabel: 'process_high'   { cpus = params.cores                           }

    // DADA2_DENOISE processes one sample per job; dada() only parallelises
    // across multiple samples in a single call, so extra threads are wasted.
    // Use 1 CPU to allow all 72 cores to run samples simultaneously.
    withName: 'DADA2_DENOISE' { cpus = 1 }
}

// ─── Profiles ────────────────────────────────────────────────────────────────

profiles {

    // Local execution — no containers
    standard {
        process.executor = 'local'
    }

    // Docker containers
    docker {
        docker.enabled         = true
        docker.userEmulation   = true
        singularity.enabled    = false
        process {
            withLabel: 'process_single' { memory = '6.GB';  time = '4.h'  }
            withLabel: 'process_low'    { memory = '12.GB'; time = '4.h'  }
            withLabel: 'process_medium' { memory = '36.GB'; time = '8.h'  }
            withLabel: 'process_high'   { memory = '72.GB'; time = '16.h' }
        }
    }

    // Singularity containers (HPC)
    singularity {
        singularity.enabled    = true
        singularity.autoMounts = true
        docker.enabled         = false
        process {
            withLabel: 'process_single' { memory = '6.GB';  time = '4.h'  }
            withLabel: 'process_low'    { memory = '12.GB'; time = '4.h'  }
            withLabel: 'process_medium' { memory = '36.GB'; time = '8.h'  }
            withLabel: 'process_high'   { memory = '72.GB'; time = '16.h' }
        }
    }

    // SLURM HPC cluster
    slurm {
        process.executor       = 'slurm'
        process.queue          = 'compute'
        singularity.enabled    = true
        singularity.autoMounts = true
        process {
            withLabel: 'process_single' { memory = '6.GB';  time = '4.h';  queue = 'short'   }
            withLabel: 'process_low'    { memory = '12.GB'; time = '4.h';  queue = 'short'   }
            withLabel: 'process_medium' { memory = '36.GB'; time = '8.h';  queue = 'compute' }
            withLabel: 'process_high'   { memory = '72.GB'; time = '16.h'; queue = 'compute' }
        }
    }

    // PBS/Torque HPC cluster
    pbs {
        process.executor       = 'pbspro'
        singularity.enabled    = true
        singularity.autoMounts = true
    }

    // Test profile — tiny synthetic data for CI (preview and unit tests)
    test {
        params {
            fastq_dir        = "${projectDir}/tests/data/fastq"
            outdir           = 'test_results'
            cores            = 2
            skip_db_download = true
            run_ecology      = false
            run_full_ecology = false
            databases {
                '16S' {
                    path   = "${projectDir}/tests/data/databases/silva_16S_test.fa.gz"
                    type   = 'silva'
                    method = 'dada2'
                }
            }
        }
        process {
            withLabel: 'process_high'   { memory = '4.GB' }
            withLabel: 'process_medium' { memory = '4.GB' }
        }
    }
}

// ─── Reporting ───────────────────────────────────────────────────────────────

def trace_timestamp = new java.util.Date().format('yyyy-MM-dd_HH-mm-ss')

report {
    enabled   = true
    overwrite = true
    file      = "${params.outdir}/pipeline_info/execution_report_${trace_timestamp}.html"
}

timeline {
    enabled   = true
    overwrite = true
    file      = "${params.outdir}/pipeline_info/execution_timeline_${trace_timestamp}.html"
}

trace {
    enabled   = true
    overwrite = true
    file      = "${params.outdir}/pipeline_info/execution_trace_${trace_timestamp}.txt"
}

dag {
    enabled   = true
    overwrite = true
    file      = "${params.outdir}/pipeline_info/pipeline_dag_${trace_timestamp}.svg"
}

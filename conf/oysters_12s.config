// Real database paths for the 12S Tapirs + SINTAX branches, reusing the
// same reference data already staged for the 12S-edna-dada2-tapirs-workflow
// Snakemake pipeline.
params {
    tapirs {
        enabled    = true
        experiment = '12s_oysters'
        blast {
            db = '/prj/DECODE/Tapirs/resources/databases/12s_fish_blast_db/12s_fish'
        }
        kraken2 {
            db = '/prj/DECODE/Tapirs/resources/databases/12s_fish_kraken2_db'
        }
        taxdump         = '/prj/DECODE/Tapirs/resources/databases/new_taxdump'
        dechim_blast_db = '/prj/DECODE/Tapirs/resources/databases/12s_fish_blast_db/12s_fish.fasta'
    }
    sintax {
        enabled = true
        db_paths = [
            INBO:   '/prj/DECODE/12S_pipeline/edna-12s-pipeline/reference_db/all_seqs_INBO_riaz_amplified.sintax.fasta',
            MIDORI: '/prj/DECODE/12S_pipeline/edna-12s-pipeline/reference_db/MIDORI2_LONGEST_NUC_GB269_srRNA_SINTAX.fasta.gz',
            CLARE:  '/prj/DECODE/12S_pipeline/edna-12s-pipeline/reference_db/12s_verts.trimmed_RiazV5.sintax.fasta'
        ]
    }
}
